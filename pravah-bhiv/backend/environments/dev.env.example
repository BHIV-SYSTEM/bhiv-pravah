# ==============================================================================
# PRAVAH Control Plane — Development Environment Template (dev.env.example)
# Target: Local development workstation
# Safe for version control. Copy to dev.env and adjust for local environment.
# ==============================================================================

# --- Core Runtime ---
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=DEBUG

# --- Networking & CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Local Infrastructure (See REDIS_SETUP_GUIDE.py) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pravah_dev
DB_USER=postgres
DB_PASSWORD=

# --- Deployment & Autonomy Thresholds ---
DEPLOYMENT_TIMEOUT=60
RETRY_COUNT=3
HEALTH_CHECK_INTERVAL=30
LATENCY_THRESHOLD_MS=12000
LOW_SCORE_THRESHOLD=50
HIGH_HEART_RATE=100
LOW_OXYGEN_LEVEL=95
ENABLE_METRICS=true
DASHBOARD_PORT=8501
AUTONOMY_DECISIONS_ENABLED=true
AUTONOMY_LEARNING_ENABLED=false

# --- Cryptographic Signing Keys ---
# In development, these default to built-in development keys if omitted or empty.
JWT_SECRET_KEY=default-jwt-secret-change-in-prod
LINEAGE_SIGNING_KEY=pravah-sovereign-lineage-key
SSPL_SECRET_KEY=default-secret-key-change-in-prod
