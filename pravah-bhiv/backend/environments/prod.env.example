# =============================================================================
# Pravah Production Environment Configuration Template (prod.env.example)
# Target: Yotta Bare-Metal VM (Docker Compose + systemd)
#
# IMPORTANT: Replace all ##SECRET## and ##YOTTA_URL## placeholders before
# deploying to Yotta. Inject secrets via Yotta Secrets Manager or a
# secrets management tool — never commit real values to VCS.
# =============================================================================

# --- Core ---
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# --- Production Flags (must be false in production) ---
DEMO_MODE=false
DEMO_FREEZE_MODE=false

# --- Pravah Service Ports ---
CONTROL_PLANE_PORT=7000
DECISION_BRAIN_PORT=8000
OBSERVER_PORT=8600
PRAVAH_OBSERVER_PORT=8600
REDIS_PORT=6380

# --- Redis (self-hosted container on Yotta VM) ---
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_DB=2
REDIS_MAX_MEMORY=512mb
REDIS_PASSWORD=##WILL_BE_INJECTED_BY_SECRETS_MANAGER##

# --- Gunicorn / Uvicorn Worker Counts ---
GUNICORN_WORKERS=4
UVICORN_WORKERS=2

# --- Docker Image Tag ---
IMAGE_TAG=prod

# --- Host IP (used by docker-compose.prod.yml as the ${VM_IP} fallback
# for building external service URLs, e.g. health checks) ---
VM_IP=##PRODUCTION_HOST_IP##

# --- Trace Signing Key (SSPL) ---
# REPLACE with actual secret via Yotta Secrets Manager
SSPL_SECRET_KEY=##WILL_BE_INJECTED_BY_SECRETS_MANAGER##
LINEAGE_SIGNING_KEY=##WILL_BE_INJECTED_BY_SECRETS_MANAGER##

# --- JWT / Auth ---
JWT_SECRET_KEY=##WILL_BE_INJECTED_BY_SECRETS_MANAGER##

# --- Deployment Settings ---
DEPLOYMENT_TIMEOUT=60
RETRY_COUNT=1
HEALTH_CHECK_INTERVAL=30

# --- Production Thresholds ---
LATENCY_THRESHOLD_MS=12000
LOW_SCORE_THRESHOLD=50
HIGH_HEART_RATE=110
LOW_OXYGEN_LEVEL=98

# --- Monitoring & Metrics ---
ENABLE_METRICS=true
DASHBOARD_PORT=9090

# --- CORS ---
BACKEND_CORS_ORIGINS=https://pravah.blackholeinfiverse.com,http://localhost:4500,http://localhost:3000,http://localhost:8000
BACKEND_CORS_ORIGIN_REGEX=""

# --- Autonomy Gates ---
AUTONOMY_DECISIONS_ENABLED=true
AUTONOMY_LEARNING_ENABLED=false

# --- Emergency Freeze (Manual Override) ---
EMERGENCY_FREEZE_ENABLED=false
EMERGENCY_FREEZE_REASON=

# =============================================================================
# Observed Service URLs
# Replace ##YOTTA_URL:*## with actual production endpoints on Yotta or external
# =============================================================================

# Pravah internal services (Docker DNS — do NOT change unless using host network)
PRAVAH_CONTROL_PLANE=http://control-plane:7000
PRAVAH_MAIN_API=http://decision-brain:8000

# External observed services — set to real Yotta / production URLs
PRAVAH_GURUKUL_API=##YOTTA_URL:GURUKUL_BACKEND##
PRAVAH_HR_API=https://bhiv-hr-gateway-l0xp.onrender.com
PRAVAH_BHIV_HR_AGENT=https://bhiv-hr-agent-cato.onrender.com
PRAVAH_BHIV_HR_LANGGRAPH=https://bhiv-hr-langgraph-luy9.onrender.com
PRAVAH_PARIKSHAK_API=https://parikshak.blackholeinfiverse.com/api
PRAVAH_CRM_API=https://ai-crm-4nje.onrender.com
PRAVAH_PROMPT_RUNNER_API=https://prompt-runner.onrender.com
PRAVAH_TRADE_BOT_API=##YOTTA_URL:TRADE_BOT##
PRAVAH_TTG_API=https://ttg-backend-55ce.onrender.com
PRAVAH_UNIGURU_API=https://uniguru-ai-2.onrender.com
PRAVAH_WORKFLOW_BLACKHOLE_API=https://blackholeworkflow.onrender.com
PRAVAH_BLOCKCHAIN_API=##YOTTA_URL:BLOCK_CHAIN_UPDATED##
PRAVAH_MASTERDB_API=https://masterdb-ingestion-certification-service.onrender.com
PRAVAH_MITRA_API=https://bhiv-mitra.onrender.com
PRAVAH_SVACS_API=##YOTTA_URL:BHIV_SVACS_UNIFIED_CORE##

# BHIV Runtime services
PRAVAH_BHIV_KARMA=##YOTTA_URL:BHIV_KARMA##
PRAVAH_BHIV_BUCKET=https://bhiv-bucket-i1l6.onrender.com
PRAVAH_BHIV_CORE=##YOTTA_URL:BHIV_CORE##
PRAVAH_BHIV_CORE_EVENTS=##YOTTA_URL:BHIV_CORE_EVENTS##
PRAVAH_BHIV_CORE_WEBHOOKS=##YOTTA_URL:BHIV_CORE_WEBHOOKS##
PRAVAH_BHIV_WORKFLOW=##YOTTA_URL:BHIV_WORKFLOW##
PRAVAH_BHIV_UAO=##YOTTA_URL:BHIV_UAO##
PRAVAH_BHIV_INSIGHT_CORE=https://tantra-core.onrender.com
PRAVAH_BHIV_INSIGHT_FLOW_BRIDGE=https://insightbridge-phase-4-2-integration-demo.onrender.com
PRAVAH_BHIV_INSIGHT_FLOW_BACKEND=https://tantra-insightflow.onrender.com
PRAVAH_BHIV_KESHAV=##YOTTA_URL:BHIV_KESHAV_4##
PRAVAH_BHIV_SARATHI=https://sarathi-9n5g.onrender.com
PRAVAH_SAMRUDDHI_API=https://samruddhi.blackholeinfiverse.com/api
PRAVAH_SAMRUDDHI_HFT=https://samruddhi.blackholeinfiverse.com/hft
