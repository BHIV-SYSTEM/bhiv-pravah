# ==============================================================================
# PRAVAH Control Plane — Staging Environment Template (stage.env.example)
# Target: Staging Pre-Production Environment
# Safe for version control. Copy to stage.env and populate with confirmed values.
#
# IMPORTANT:
# 1. Do NOT commit stage.env to version control once populated with real secrets.
# 2. Hostnames marked [UNCONFIRMED] are illustrative examples and require
#    actual VPC/internal DNS endpoints from the Platform Owner.
# ==============================================================================

# --- Core Runtime ---
ENVIRONMENT=stage
DEBUG=false
LOG_LEVEL=INFO

# --- Networking & CORS ---
# [UNCONFIRMED] Replace with confirmed staging frontend domain
BACKEND_CORS_ORIGINS=["https://stage-pravah.internal"]
ALLOWED_HOSTS=["stage-pravah.internal","127.0.0.1"]

# --- Infrastructure Endpoints ---
# [UNCONFIRMED] Must be confirmed by Platform Owner (VPC internal endpoint)
REDIS_HOST=stage-redis.internal
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# --- Database Configuration ---
# [UNCONFIRMED] Must be confirmed by Platform Owner (VPC internal endpoint)
DB_HOST=stage-db.internal
DB_PORT=5432
DB_NAME=pravah_stage
DB_USER=pravah_app
# [MANDATORY] Supply actual database password
DB_PASSWORD=

# --- Deployment & Autonomy Thresholds ---
DEPLOYMENT_TIMEOUT=60
RETRY_COUNT=2
HEALTH_CHECK_INTERVAL=30
LATENCY_THRESHOLD_MS=12000
LOW_SCORE_THRESHOLD=50
HIGH_HEART_RATE=105
LOW_OXYGEN_LEVEL=95
ENABLE_METRICS=true
DASHBOARD_PORT=8501
AUTONOMY_DECISIONS_ENABLED=true
AUTONOMY_LEARNING_ENABLED=false

# --- Cryptographic Signing Keys ---
# MANDATORY: The application fails closed and will intentionally refuse to start
# if any of these are unset, empty, whitespace-only, or using development
# fallback/placeholder strings.
#
# Platform Owner must generate 64-character high-entropy cryptographic keys and
# inject them via deployment environment variables or uncomment them below:
# JWT_SECRET_KEY=
# LINEAGE_SIGNING_KEY=
# SSPL_SECRET_KEY=
